{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "name",
    "notes",
    "room_cost_cents_m2",
    "demolition_cents_m2",
    "room_hours",
    "upgrade_hours",
    "cooldown_days",
    "collaborate_limit_cents",
    "grow_limit_cents",
    "space_targets_m2_person",
    "weights",
    "upgrades"
  ],
  "properties": {
    "format": {
      "const": "courtyard-living-kit"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "room_cost_cents_m2": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 200000
    },
    "demolition_cents_m2": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 50000
    },
    "room_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 336
    },
    "upgrade_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 168
    },
    "cooldown_days": {
      "type": "integer",
      "minimum": 2,
      "maximum": 90
    },
    "collaborate_limit_cents": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 3000000
    },
    "grow_limit_cents": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 5000000
    },
    "space_targets_m2_person": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 12,
        "maximum": 32
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmth",
        "space",
        "water",
        "waste",
        "power"
      ],
      "properties": {
        "warmth": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "space": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "water": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "waste": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "power": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "upgrades": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "field",
          "amount",
          "cost_cents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "field": {
            "enum": [
              "water_l_day",
              "sewage_l_day",
              "waste_kg",
              "solar_kw",
              "battery_kwh",
              "tank_l"
            ]
          },
          "amount": {
            "type": "number",
            "minimum": 1,
            "maximum": 2000
          },
          "cost_cents": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 5000000
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
