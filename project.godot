; Courtyard Block — Godot 4.7
config_version=5

[application]
config/name="Courtyard Block"
run/main_scene="res://world/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A small place. A shared life. An open community simulator."
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.91, 0.9, 0.85, 1)
anti_aliasing/quality/msaa_3d=1

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[audio]
driver/enable_input=false
